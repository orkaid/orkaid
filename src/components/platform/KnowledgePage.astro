---
// Knowledge index body (PR-03): only resources that exist, with their type, audience and content date.
import { localePath, type Locale } from '../../i18n/ui';
import { LINKS, longDate, resourceKinds, resources } from '../../i18n/platform';
import ExtLink from './ExtLink.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = {
  de: {
    eyebrow: 'Wissen',
    title: 'Wissen und Anleitungen',
    lead: 'Grundlagen zum Verstehen, Anleitungen zum Erledigen. Jeder Beitrag nennt seine Quellen, seinen Stand und seine Grenzen und verweist auf das passende Werkzeug.',
    for: 'Für',
    updated: 'Stand',
    elsewhere: 'An anderer Stelle',
    elsewhereText: ['Wie die Werkzeuge entstehen, dokumentieren', 'das Build-Log auf Substack', 'und', 'die Videos auf YouTube', '.'],
  },
  en: {
    eyebrow: 'Knowledge',
    title: 'Knowledge and guides',
    lead: 'Foundations to understand, guides to get things done. Every resource states its sources, date and limits, and links to the matching tool.',
    for: 'For',
    updated: 'Updated',
    elsewhere: 'Elsewhere',
    elsewhereText: ['How the tools are built is documented in', 'the build log on Substack', 'and', 'the videos on YouTube', '.'],
  },
}[locale];
---
<header class="page-head">
  <p class="eyebrow">{c.eyebrow}</p>
  <h1 class="title-page">{c.title}</h1>
  <p class="lead">{c.lead}</p>
</header>

<ol class="k-list">
  {resources.map((r) => (
    <li>
      <p class="kind">{resourceKinds[r.kind][locale]}</p>
      <div>
        <h2><a href={localePath(locale, r.path)}>{r.title[locale]}</a></h2>
        <p>{r.summary[locale]}</p>
      </div>
      <dl class="meta">
        <div><dt>{c.for}</dt><dd>{r.audience[locale]}</dd></div>
        <div><dt>{c.updated}</dt><dd><time datetime={r.updated}>{longDate(r.updated, locale)}</time></dd></div>
      </dl>
    </li>
  ))}
</ol>

<section class="band quiet" aria-labelledby="elsewhere-title">
  <h2 id="elsewhere-title" class="title-section">{c.elsewhere}</h2>
  <p>{c.elsewhereText[0]} <ExtLink href={LINKS.substack} locale={locale}>{c.elsewhereText[1]}</ExtLink> {c.elsewhereText[2]} <ExtLink href={LINKS.youtube} locale={locale}>{c.elsewhereText[3]}</ExtLink>{c.elsewhereText[4]}</p>
</section>

<style>
  .k-list { margin: 0 0 var(--space-4); padding: 0; list-style: none; border-top: 3px solid var(--ink); }
  .k-list li { display: grid; grid-template-columns: 8rem minmax(0, 1fr) 15rem; gap: 0.5rem var(--space-3); padding-block: var(--space-3); border-bottom: 1px solid var(--rule); }
  .kind { margin: 0.3rem 0 0; font: 500 var(--fs-label)/1.6 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; }
  h2 { margin: 0; font-size: 1.25rem; font-weight: 600; line-height: 1.3; }
  h2 a { text-decoration: none; }
  h2 a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .k-list p { margin: 0.375rem 0 0; max-width: 62ch; }
  .meta { margin: 0; font-size: 0.875rem; }
  .meta div + div { margin-top: 0.5rem; }
  .meta dt { color: var(--muted); font: 500 var(--fs-label)/1.4 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .meta dd { margin: 0.125rem 0 0; }
  .quiet p { max-width: 70ch; margin: 0.5rem 0 0; color: var(--muted); }
  @media (max-width: 52rem) { .k-list li { grid-template-columns: minmax(0, 1fr); } }
</style>
