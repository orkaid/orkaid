---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import XRechnungWorkspace from '../../../../components/tools/xrechnung/XRechnungWorkspace.svelte';
import { copy } from '../../../../i18n/xrechnung';
import { localePath, ui } from '../../../../i18n/ui';
---

<BaseLayout
  locale="en"
  width="wide"
  title="XRechnung generator — Orkaid"
  description="Enter an invoice (type 380) or a credit note (type 381) and generate UBL or CII XML. Your input stays in your browser."
  pathname="/tools/xrechnung/"
>
  <header class="tool-head">
    <nav class="crumbs" aria-label={ui.en.breadcrumb}><ol><li><a href={localePath('en', '/tools/')}>{ui.en.tools}</a></li><li aria-current="page">XRechnung</li></ol></nav>
    <h1 class="title-tool">{copy.pageTitle.en}</h1>
    <p>{copy.pageIntro.en}</p>
    <ul class="tool-links">
      <li><a href={localePath('en', '/knowledge/xrechnung-erstellen/')}>Guide</a></li>
      <li><a href={localePath('en', '/knowledge/xrechnung-pruefen/')}>Check the result</a></li>
    </ul>
  </header>
  <noscript><p class="tool-noscript">{copy.noscript.en}</p></noscript>
  <div id="xr-root" data-locale="en"><XRechnungWorkspace locale="en" /></div>
  <script>
    import '../../../../components/tools/xrechnung/mount.ts';
    import '../../../../components/tools/xrechnung/bar-clearance.ts';
    import '../../../../components/tools/xrechnung/leave-guard.ts';
  </script>
</BaseLayout>

<style>
  .tool-head { padding-block: var(--space-2); }
  .tool-head > p { margin: 0.25rem 0 0; max-width: 70ch; color: var(--muted); }
  .tool-links { display: flex; flex-wrap: wrap; gap: 0 var(--space-3); margin: 0.25rem 0 0; padding: 0; list-style: none; font-weight: 500; font-size: 0.9375rem; }
  .tool-links a { display: inline-flex; align-items: center; min-height: var(--target); }
  .tool-noscript { padding: var(--space-2); border: 1px solid var(--ink); }
  /* PR-11 dialog, created by leave-guard.ts outside this component's scope. */
  :global(.leave-dialog) { max-width: min(32rem, calc(100vw - 2rem)); padding: var(--space-3); border: 1px solid var(--ink); background: var(--paper); color: var(--ink); box-shadow: 0.375rem 0.375rem 0 var(--rule); }
  :global(.leave-dialog::backdrop) { background: rgb(29 35 33 / 0.45); }
  :global(.leave-dialog h2) { margin: 0 0 0.5rem; font-size: 1.25rem; font-weight: 600; }
  :global(.leave-dialog p) { margin: 0 0 var(--space-2); }
  :global(.leave-actions) { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  :global(.leave-actions button) { min-height: var(--target); padding: 0.5rem 1rem; border: 1px solid var(--ink); background: var(--paper); color: var(--ink); font: 500 0.9375rem/1.3 var(--sans); cursor: pointer; }
  :global(.leave-actions .leave-stay) { background: var(--ink); color: var(--paper); }
</style>
